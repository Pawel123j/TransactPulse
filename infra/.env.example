# Copy to infra/.env and adjust as needed. Compose reads it automatically.
# NOTE: .env is gitignored — never commit real secrets (these are local dev only).

# MinIO credentials (root user/password for the object store + console login).
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# Lakehouse bucket created by the createbuckets init container.
LAKEHOUSE_BUCKET=lakehouse

# Number of partitions for the transactions.raw topic.
TOPIC_PARTITIONS=3
